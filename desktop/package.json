{
  "name": "remedy-crm",
  "version": "1.6.0",
  "private": true,
  "description": "Remedy CRM offline remedies, customer management, bookings, accounts and invoices",
  "author": "Shree Swami Samarth Vastu and Astrology Consultancy",
  "main": "main.cjs",
  "scripts": {
    "stage": "node stage.cjs",
    "dist:win": "npm run stage && node build-win.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.swamisamarth.remedycrm",
    "productName": "Remedy CRM",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "whatsapp.cjs",
      "app/**/*",
      "icon.ico"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "Remedy-CRM-Setup-${version}.${ext}",
      "signExecutable": false,
      "electronLanguages": [
        "en-US",
        "hi",
        "mr"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remedy CRM",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "guid": "38a6638f-04d2-5d6c-acf9-32cab91581b7",
      "uninstallDisplayName": "Remedy CRM"
    },
    "publish": []
  }
}
