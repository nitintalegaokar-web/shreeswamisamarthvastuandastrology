{
  "name": "kp-master-desktop",
  "version": "1.2.11",
  "description": "KP MASTER offline astrology desktop application",
  "author": "Nitin Talegaonkar",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node prepare.cjs",
    "start": "npm run prepare-app && electron .",
    "test": "node --test test/*.test.cjs",
    "test:runtime": "node test/runtime.cjs",
    "test:licensing": "node test/licensing-runtime.cjs",
    "build:windows": "npm run prepare-app && electron-builder --win portable --x64",
    "build:owner": "node owner/prepare.cjs && electron-builder --projectDir owner --win portable --x64",
    "build:setup": "node build-setup.cjs",
    "build:owner:setup": "node build-setup.cjs --owner",
    "build:owner-edition:setup": "node build-setup.cjs --owner-edition",
    "test:owner-runtime": "node test/owner-runtime.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "in.kpmaster.astrology",
    "productName": "KP MASTER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "preload.cjs",
      "licensing/core.cjs",
      "licensing/trust.cjs",
      "licensing/system-id.cjs",
      "licensing/gate.cjs",
      "licensing/activation.html",
      "licensing/activation.js",
      "app/**/*",
      "package.json",
      "licensing/activation-code.cjs",
      "licensing/demo.cjs",
      "licensing/feature-policy.cjs",
      "licensing/features.json"
    ],
    "asar": true,
    "win": {
      "electronLanguages": [
        "en-US",
        "mr"
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signExecutable": false,
      "artifactName": "KP-Master-Offline-Windows-${version}-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "KP-Master-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "include": "installer.nsh",
      "differentialPackage": false
    },
    "publish": []
  }
}
